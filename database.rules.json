{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "houses": {
      ".read": true,
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "$id.length <= 16 && $id.matches(/^w[0-9]+$/) && newData.hasChildren(['lat', 'lng', 'status', 'owner', 't'])",
        "lat":    { ".validate": "newData.isNumber() && newData.val() > 38.840 && newData.val() < 38.852" },
        "lng":    { ".validate": "newData.isNumber() && newData.val() > -121.258 && newData.val() < -121.239" },
        "addr":   { ".validate": "newData.isString() && newData.val().length <= 60" },
        "status": { ".validate": "newData.val() === 'yes' || newData.val() === 'no'" },
        "candy":  { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
        "tags": {
          "decor":  { ".validate": "newData.isBoolean()" },
          "haunt":  { ".validate": "newData.isBoolean()" },
          "teal":   { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        "note":   { ".validate": "newData.isString() && newData.val().length <= 140" },
        "owner":  { ".validate": "newData.val() === auth.uid" },
        "t":      { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },
    "ratings": {
      ".read": true,
      "$houseId": {
        ".write": "auth != null && !newData.exists() && (root.child('houses').child($houseId).child('owner').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('houses').child($houseId).child('status').val() === 'yes' && root.child('houses').child($houseId).child('owner').val() !== auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        }
      }
    },
    "reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$houseId": {
        ".read": "auth != null && root.child('houses').child($houseId).child('owner').val() === auth.uid",
        ".write": "auth != null && !newData.exists() && (root.child('admins').child(auth.uid).val() === true || (root.child('houses').child($houseId).child('owner').val() === auth.uid && !newData.parent().parent().child('houses').child($houseId).exists()))",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('houses').child($houseId).exists() && root.child('houses').child($houseId).child('owner').val() !== auth.uid))",
          ".validate": "newData.hasChildren(['t'])",
          "note":   { ".validate": "newData.isString() && newData.val().length <= 140" },
          "t":      { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
